.env
.env.*
!.env.example
wtw/.env

# ========================================
# CACHE E LOGS
# ========================================
storage/logs/*.log
storage/cache/*
!storage/logs/.gitkeep
!storage/cache/.gitkeep
*.log

# Logs antigos no public/api (migrar para storage/logs)
public/api/error_*.log

# ========================================
