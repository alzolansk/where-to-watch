# ========================================
# WHERE YOU WATCH - Configurações de Ambiente
# ========================================
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env no Git!

# ========================================
# APLICAÇÃO
# ========================================
# Ambiente: development (local) ou production (servidor)
APP_ENV=development

# Debug: true (local) ou false (produção)
APP_DEBUG=true

# URL base da aplicação
# DESENVOLVIMENTO (com pasta public/): http://localhost/WhereToWatch/wtw/public
# PRODUÇÃO (sem pasta public/): https://seusite.com/wtw
# Se não definir, o sistema detecta automaticamente!
APP_URL=http://localhost/WhereToWatch/wtw/public

# ========================================
# BANCO DE DADOS
# ========================================
# Host do MySQL (localhost para XAMPP, IP do servidor em produção)
DB_HOST=localhost

# Nome do banco de dados
DB_NAME=db_login

# Usuário do banco
DB_USER=root

# Senha do banco (vazio no XAMPP, forte em produção)
DB_PASS=

# Porta do MySQL (padrão: 3306)
DB_PORT=3306

# ========================================
# TMDB API (The Movie Database)
# ========================================
# Obtenha sua chave em: https://www.themoviedb.org/settings/api
# É GRATUITO! Apenas crie uma conta e solicite uma API Key

# API Key v3 (obrigatório)
TMDB_API_KEY=sua_chave_api_aqui

# Bearer Token v4 (opcional, mas recomendado)
TMDB_BEARER=seu_bearer_token_aqui

# URL base da API (não altere)
TMDB_API_BASE=https://api.themoviedb.org/3

# ========================================
# SESSÃO
# ========================================
# Tempo de vida da sessão em minutos (120 = 2 horas)
SESSION_LIFETIME=120

# Nome do cookie de sessão
SESSION_NAME=WYW_SESSION

# ========================================
# CACHE
# ========================================
# Driver de cache: file (padrão), redis, memcached
CACHE_DRIVER=file

# Tempo de cache em segundos (3600 = 1 hora)
CACHE_TTL=3600

# TTL para requisições TMDB (7200 = 2 horas)
TMDB_CACHE_TTL=7200

# ========================================
# LOGS
# ========================================
# Canal de logs: file (padrão), syslog, errorlog
LOG_CHANNEL=file

# Nível de log: debug, info, warning, error
# Use 'debug' em desenvolvimento e 'error' em produção
LOG_LEVEL=debug

# ========================================
# SEGURANÇA (Produção)
# ========================================
# Ative apenas em produção com HTTPS
# FORCE_HTTPS=true
# SECURE_COOKIES=true

# ========================================
# PERFORMANCE
# ========================================
# Limite de memória para scripts PHP (128M padrão)
# PHP_MEMORY_LIMIT=256M

# Tempo máximo de execução (30s padrão)
# PHP_MAX_EXECUTION_TIME=60

# ========================================
# RECURSOS EXTERNOS
# ========================================
# URL base para imagens do TMDB (não altere)
TMDB_IMAGE_BASE=https://image.tmdb.org

# ========================================
# FEATURES FLAGS (Opcionais)
# ========================================
# Ativar/desativar funcionalidades em teste
# ENABLE_ROULETTE=true
# ENABLE_ONBOARDING=true
# ENABLE_TELEMETRY=true
# ENABLE_CACHE_WARMUP=false
